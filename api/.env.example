DB_USER=
DB_PASSWORD=
DB_HOST=
DB_NAME=
GH_CLIENT_ID=
GH_CLIENT_SECRET=
# RAG Chatbot — LLM provider
# Opção 1: Groq (GRATUITO) — https://console.groq.com/keys
GROQ_API_KEY=
# Modelo Groq a usar (opcional, padrão: openai/gpt-oss-20b) — rode `GET https://api.groq.com/openai/v1/models` com sua chave para ver os modelos disponíveis na sua conta
GROQ_MODEL=openai/gpt-oss-20b
# Opção 2: OpenAI (pago) — https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Define qual provedor usar: 'groq' (padrão, gratuito) ou 'openai'
LLM_PROVIDER=groq